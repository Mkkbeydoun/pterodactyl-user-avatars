{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "user-avatars",
    "name": "User Avatars",
    "version": "3.0.0",
    "description": "Let users upload their own profile picture, shown in the navigation bar, admin user lists and server subuser lists.",
    "author": "RustixDev",
    "icon": "circle-user",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": ">=2.0.0-beta.4 <3.0",
        "php": "^8.3"
    },
    "provider": "UserAvatars\\UserAvatarsProvider",
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "uavt",
        "screens": []
    }
}
